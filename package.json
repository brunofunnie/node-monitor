{
  "name": "node-monitor",
  "version": "1.2.0",
  "description": "Gerenciador simples de processos Node.js",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.funnietech.nodemonitor",
    "productName": "Node Monitor",
    "files": [
      "*.js",
      "index.html",
      "style.css",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.utilities"
    }
  }
}
